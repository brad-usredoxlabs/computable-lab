# Generated by vite-plugin-pwa during dev/build
app/dev-dist/

# Environment and config
.env
config.yaml
# Backups of config.yaml carry LIVE API KEYS. A dated backup (config.yaml.bak-*)
# was swept into a merge commit by `git add -A` on 2026-11-09 and blocked the push
# via GitHub secret scanning; never let one in again.
config.yaml.bak*
*.bak-[0-9]*
nano.*.save
.claude/settings.local.json

# Test artifacts
test-results/
screenshots/
playwright-report/

# Symlinks in server/ (point to monorepo root)
server/schema
server/records
server/config

# Ontology download cache
scripts/.ontology-cache/*
!scripts/.ontology-cache/.gitkeep

# Playwright MCP runtime artifacts
.playwright-mcp/

# SDK test byproduct (analysisRunner tests run real python entry scripts)
server/model.pkl
app/dist-viewer/
__pycache__/
